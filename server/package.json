{
  "name": "@starfall/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "bench:rss": "node --expose-gc tools/rss-bench.mjs",
    "bench:blocking": "node tools/blocking-bench.mjs",
    "check:proto": "node tools/proto-check.mjs",
    "demo:error": "node tools/error-demo.mjs",
    "check:paths": "node tools/path-check.mjs",
    "check:net": "node tools/net-check.mjs",
    "typecheck": "tsc --noEmit -p .",
    "dev:env": "node --env-file=.env --watch src/index.ts"
  },
  "dependencies": {
    "@starfall/shared": "*",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  }
}
