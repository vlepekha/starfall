{
  "name": "starfall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "npm run dev:server & npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run build && npm run start --workspace server",
    "assets": "npm run assets --workspace client",
    "bench:physics": "npm run bench:physics --workspace client",
    "bench:rss": "npm run bench:rss --workspace server",
    "bench:blocking": "npm run bench:blocking --workspace server",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "bench:step": "npm run bench:step --workspace server",
    "bench:load": "npm run bench:load --workspace server",
    "profile": "npm run profile --workspace server",
    "chart:load": "node server/tools/load-chart.mjs > docs/load-chart.svg"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.3.0",
    "@playwright/test": "^1.50.0"
  }
}
